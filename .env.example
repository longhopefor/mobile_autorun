DATABASE_URL=postgres://mobile_autorun:CHANGE_THIS_PASSWORD@127.0.0.1:5432/mobile_autorun?sslmode=disable
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
LISTEN_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://localhost:8080
DATA_DIR=.data
# Compose only: set 0.0.0.0 for LAN access and update WEB_ORIGIN accordingly
# SERVER_BIND_IP=127.0.0.1
# MODEL_API_KEY=configure_only_if_using_api

# 电商素材：中文字体 / ffmpeg；留空使用系统默认
MATERIAL_FONT_PATH=
MATERIAL_FFMPEG_BINARY=ffmpeg
# 可选：自有 AI 场景图 / 视频生成适配器，协议见 docs/business-workflows.md
MATERIAL_GENERATOR_URL=
MATERIAL_GENERATOR_API_KEY=
